<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ScanSortierer.ViewModels"
        xmlns:core="using:ScanSortierer.Core.Vorlagen"
        x:Class="ScanSortierer.Views.HauptFenster"
        x:DataType="vm:HauptViewModel"
        x:Name="Fenster"
        Title="Scan-Sortierer"
        Icon="avares://ScanSortierer/Assets/scan-sortierer.ico"
        Width="1400" Height="880" MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterScreen">

  <Grid RowDefinitions="Auto,Auto,*,Auto">

    <!-- Kopfleiste -->
    <Border Grid.Row="0" Background="{StaticResource PinselLeiste}" BorderBrush="{StaticResource PinselRahmen}" BorderThickness="0,0,0,1" Padding="16,10">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto">
        <Button Grid.Column="0" Command="{Binding OrdnerWaehlenCommand}" ToolTip.Tip="Eingangsordner wählen">
          <TextBlock Text="{Binding EingangsordnerAnzeige}" MaxWidth="520" TextTrimming="CharacterEllipsis" />
        </Button>
        <Border Grid.Column="1" Classes="abzeichen" Margin="14,0,0,0" VerticalAlignment="Center" IsVisible="{Binding Testbetrieb}"
                ToolTip.Tip="Originale werden nie verschoben oder gelöscht. Umschalten in den Einstellungen.">
          <TextBlock Text="TESTBETRIEB: Originale bleiben erhalten" Foreground="{StaticResource PinselWarnung}" FontWeight="SemiBold" FontSize="12" />
        </Border>
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8">
          <Button Content="Neu einlesen" Command="{Binding EinlesenCommand}" ToolTip.Tip="Eingangsordner erneut einlesen" />
          <Button Content="Einstellungen" Command="{Binding EinstellungenCommand}" />
          <Button Content="Vorlagen" Command="{Binding VorlagenCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Hinweise -->
    <ItemsControl Grid.Row="1" ItemsSource="{Binding Hinweise}" IsVisible="{Binding HatHinweise}" Margin="16,8,16,0">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="x:String">
          <Border Classes="hinweis" Margin="0,0,0,4">
            <Grid ColumnDefinitions="*,Auto">
              <SelectableTextBlock Text="{Binding}" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12.5" />
              <Button Grid.Column="1" Classes="link" Content="Schließen" Margin="10,0,0,0" FontSize="12"
                      Command="{Binding #Fenster.((vm:HauptViewModel)DataContext).HinweisSchliessenCommand}" CommandParameter="{Binding}" />
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <Grid Grid.Row="2" ColumnDefinitions="230,*,380">

      <!-- Dateiliste -->
      <Border Grid.Column="0" Background="{StaticResource PinselPanel}" BorderBrush="{StaticResource PinselRahmen}" BorderThickness="0,0,1,0">
        <DockPanel Margin="10,14,10,10">
          <TextBlock DockPanel.Dock="Top" Classes="kopf" Text="{Binding DateienTitel}" Margin="2,0,0,8" />
          <ListBox Classes="dateien" ItemsSource="{Binding Dateien}" SelectedItem="{Binding ListenAuswahl}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:DateiViewModel">
                <StackPanel Spacing="1">
                  <TextBlock Text="{Binding Anzeige}" TextTrimming="CharacterEllipsis"
                             Classes.leise="{Binding IstErledigt}" />
                  <TextBlock Text="{Binding Hinweis}" Classes="leise" FontSize="11" TextTrimming="CharacterEllipsis"
                             Foreground="{Binding IstFehlerhaft, Converter={x:Static vm:Konverter.FehlerFarbe}}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <!-- Seiten -->
      <DockPanel Grid.Column="1" Margin="18,14,18,12">
        <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
          <WrapPanel.Styles>
            <Style Selector="Button">
              <Setter Property="Margin" Value="0,0,8,6" />
            </Style>
          </WrapPanel.Styles>
          <Button Content="↺ Links drehen" Command="{Binding LinksDrehenCommand}" ToolTip.Tip="Gewählte Seiten gegen den Uhrzeigersinn drehen" />
          <Button Content="↻ Rechts drehen" Command="{Binding RechtsDrehenCommand}" ToolTip.Tip="Gewählte Seiten im Uhrzeigersinn drehen" />
          <Button Content="◀ Verschieben" Command="{Binding NachLinksCommand}" ToolTip.Tip="Gewählte Seiten eine Position nach vorne (oder Seite mit der Maus ziehen)" />
          <Button Content="Verschieben ▶" Command="{Binding NachRechtsCommand}" ToolTip.Tip="Gewählte Seiten eine Position nach hinten" />
          <Button Classes="gefahr" Content="Löschen" Command="{Binding LoeschenCommand}" ToolTip.Tip="Gewählte Seiten verwerfen (Entf). Das Original bleibt unverändert." />
          <Button Content="Alle leeren Seiten markieren" Command="{Binding LeereMarkierenCommand}" />
          <Button Content="Dokument vorschlagen" Command="{Binding DokumentAuswaehlenCommand}" ToolTip.Tip="Auswahl auf das nächste erkannte Dokument zurücksetzen" />
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="4,0,0,6">
            <TextBlock Text="Größe" Classes="leise" VerticalAlignment="Center" />
            <Slider Minimum="110" Maximum="420" Width="110" Value="{Binding VorschauGroesse}" VerticalAlignment="Center" />
          </StackPanel>
        </WrapPanel>

        <Border DockPanel.Dock="Bottom" Classes="karte" Padding="12,9" Margin="0,10,0,0" MinHeight="44">
          <ScrollViewer MaxHeight="96">
            <SelectableTextBlock Text="{Binding OcrText}" TextWrapping="Wrap" Foreground="{StaticResource PinselTextLeise}" FontSize="12.5" />
          </ScrollViewer>
        </Border>

        <Grid>
          <TextBlock Text="{Binding LeerText}" IsVisible="{Binding !ZeigeSeiten}" Classes="leise" FontSize="14"
                     HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="460" TextAlignment="Center" />
          <ScrollViewer IsVisible="{Binding ZeigeSeiten}" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Seiten}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SeiteViewModel">
                  <StackPanel Orientation="Horizontal" Margin="0,4,16,16">
                    <!-- Dokumentgrenze -->
                    <StackPanel IsVisible="{Binding IstGrenze}" Margin="-6,0,8,0" Width="26" ToolTip.Tip="Hier beginnt vermutlich ein neues Dokument (Rechtsklick zum Ändern)">
                      <TextBlock Text="neu" Foreground="{StaticResource PinselWarnung}" FontSize="10.5" HorizontalAlignment="Center" Margin="0,0,0,2" />
                      <Rectangle Width="2" Height="{Binding VorschauHoehe}" Stroke="{StaticResource PinselWarnung}" StrokeThickness="2" StrokeDashArray="3,3" HorizontalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Spacing="6">
                      <Grid Width="{Binding VorschauBreite}" Height="{Binding VorschauHoehe}" Background="Transparent" Cursor="Hand"
                            Tapped="SeiteTapped" DoubleTapped="SeiteDoubleTapped" PointerPressed="SeitePointerPressed"
                            DragDrop.AllowDrop="True">
                        <Grid.ContextMenu>
                          <ContextMenu>
                            <MenuItem Header="Vorschau öffnen" Command="{Binding #Fenster.((vm:HauptViewModel)DataContext).VorschauOeffnenCommand}" CommandParameter="{Binding}" />
                            <MenuItem Header="Dokumentgrenze hier umschalten" Command="{Binding #Fenster.((vm:HauptViewModel)DataContext).GrenzeUmschaltenCommand}" CommandParameter="{Binding}" />
                            <MenuItem Header="Als leer / nicht leer markieren" Command="{Binding #Fenster.((vm:HauptViewModel)DataContext).LeerUmschaltenCommand}" CommandParameter="{Binding}" />
                          </ContextMenu>
                        </Grid.ContextMenu>
                        <Border Classes="seite" Classes.ausgewaehlt="{Binding IstAusgewaehlt}" Classes.leer="{Binding IstLeer}" Classes.fokus="{Binding IstFokus}" ClipToBounds="True">
                          <Image Source="{Binding Vorschau}" Stretch="Uniform" />
                        </Border>
                        <Rectangle IsVisible="{Binding IstLeer}" Stroke="#B24A55" StrokeThickness="2" StrokeDashArray="4,3" Fill="#40000000" RadiusX="4" RadiusY="4" IsHitTestVisible="False" />
                        <Border IsVisible="{Binding IstAusgewaehlt}" Background="{StaticResource PinselAkzent}" CornerRadius="11" Width="22" Height="22"
                                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" IsHitTestVisible="False">
                          <TextBlock Text="{Binding AuswahlNummer}" Foreground="White" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border IsVisible="{Binding OcrLaeuft}" Background="#CC23262D" CornerRadius="4" Padding="6,2" Margin="6"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom" IsHitTestVisible="False">
                          <TextBlock Text="OCR …" FontSize="10.5" Foreground="{StaticResource PinselTextLeise}" />
                        </Border>
                      </Grid>
                      <TextBlock Text="{Binding Untertitel}" HorizontalAlignment="Center" FontSize="12.5"
                                 Foreground="{Binding IstLeer, Converter={x:Static vm:Konverter.LeerFarbe}}" />
                    </StackPanel>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </DockPanel>

      <!-- Maske -->
      <Border Grid.Column="2" Background="{StaticResource PinselPanel}" BorderBrush="{StaticResource PinselRahmen}" BorderThickness="1,0,0,0">
        <ScrollViewer>
          <StackPanel Margin="16,14,16,16" Spacing="12">
            <TextBlock Classes="kopf" Text="{Binding DokumentTitel}" />

            <StackPanel>
              <TextBlock Classes="label" Text="Dokumenttyp" />
              <ComboBox ItemsSource="{Binding Vorlagen}" SelectedItem="{Binding AktuelleVorlage}" PlaceholderText="Bitte wählen">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="core:Vorlage">
                    <TextBlock Text="{Binding Name}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>

            <ItemsControl ItemsSource="{Binding Felder}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:FeldViewModel">
                  <StackPanel Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Classes="label" Text="{Binding Bezeichnung}" />
                      <TextBlock Classes="erkannt" Text="✓ erkannt" IsVisible="{Binding Erkannt}" />
                    </StackPanel>
                    <ComboBox IsVisible="{Binding IstAuswahl}" IsEditable="True" ItemsSource="{Binding Optionen}"
                              Text="{Binding Wert}" PlaceholderText="{Binding Platzhalter}"
                              Classes.erkannt="{Binding Erkannt}" Classes.fehler="{Binding HatFehler}" />
                    <TextBox IsVisible="{Binding IstEingabe}" Text="{Binding Wert}" PlaceholderText="{Binding Platzhalter}"
                             Classes.erkannt="{Binding Erkannt}" Classes.fehler="{Binding HatFehler}" LostFocus="FeldVerlassen" />
                    <TextBlock Classes="fehler" Text="{Binding Fehler}" IsVisible="{Binding HatFehler}" Margin="0,4,0,0" TextWrapping="Wrap" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel>
              <TextBlock Classes="label" Text="Stichworte / Notiz" />
              <TextBox Text="{Binding Stichworte}" PlaceholderText="nur in den Metadaten" />
            </StackPanel>

            <StackPanel>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="label" Text="Dateiname" />
                <Button Grid.Column="1" Classes="link" FontSize="12" Content="automatisch" Command="{Binding DateinameZuruecksetzenCommand}"
                        IsVisible="{Binding DateinameZuruecksetzbar}" ToolTip.Tip="Dateinamen wieder aus den Feldern bilden" />
              </Grid>
              <TextBox Text="{Binding Dateiname}" Classes.fehler="{Binding DateinameFehler, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <TextBlock Classes="fehler" Text="{Binding DateinameFehler}" IsVisible="{Binding DateinameFehler, Converter={x:Static ObjectConverters.IsNotNull}}" Margin="0,4,0,0" />
            </StackPanel>

            <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
              <Button Classes="primaer" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="12,10"
                      Content="Speichern &amp; weiter" Command="{Binding SpeichernUndWeiterCommand}" IsEnabled="{Binding !Beschaeftigt}"
                      ToolTip.Tip="Gewählte Seiten als neue PDF speichern (Strg+S)" />
              <Button Grid.Column="1" Content="Überspringen" Margin="10,0,0,0" Padding="14,10" Command="{Binding UeberspringenCommand}"
                      ToolTip.Tip="Diese Datei vorerst auslassen und zur nächsten gehen" />
            </Grid>
            <TextBlock Classes="leise" Text="{Binding ZielAnzeige}" TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <!-- Statusleiste -->
    <Border Grid.Row="3" Background="{StaticResource PinselLeiste}" BorderBrush="{StaticResource PinselRahmen}" BorderThickness="0,1,0,0" Padding="14,6">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto">
        <TextBlock Text="{Binding StatusLinks}" Classes="leise" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="1" Text="{Binding StatusOcr}" Classes="leise" VerticalAlignment="Center" Margin="12,0" />
        <TextBlock Grid.Column="2" Text="{Binding LetzteAktion}" Classes="leise" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="560" />
        <Button Grid.Column="3" Classes="link" FontSize="12" Content="Rückgängig" Margin="8,0,0,0" Command="{Binding RueckgaengigCommand}"
                IsVisible="{Binding KannRueckgaengig}" ToolTip.Tip="Letzten Schritt zurücknehmen (Strg+Z)" />
      </Grid>
    </Border>
  </Grid>
</Window>
