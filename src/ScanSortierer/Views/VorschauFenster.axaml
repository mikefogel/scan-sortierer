<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ScanSortierer.Views.VorschauFenster"
        Width="900" Height="1000" WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,*">
    <Border Background="{StaticResource PinselLeiste}" Padding="14,8">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBlock x:Name="TitelText" VerticalAlignment="Center" Classes="titel" />
        <TextBlock Text="Zoom" Classes="leise" VerticalAlignment="Center" Margin="20,0,0,0" />
        <Slider x:Name="Zoom" Minimum="0.5" Maximum="3" Value="1" Width="160" VerticalAlignment="Center" />
        <TextBlock Text="Esc schließt" Classes="leise" VerticalAlignment="Center" Margin="20,0,0,0" />
      </StackPanel>
    </Border>
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" Background="#111215">
      <Border Classes="seite" Margin="20" HorizontalAlignment="Center" VerticalAlignment="Top">
        <Image x:Name="Bild" Stretch="Uniform" />
      </Border>
    </ScrollViewer>
  </Grid>
</Window>
